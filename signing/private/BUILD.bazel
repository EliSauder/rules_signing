load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//signing:__subpackages__"])

exports_files(glob(["*.bzl"]))

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)

# Needed so `starlark_doc_extract` in //signing can follow the loads out of
# `defs.bzl`/`extensions.bzl` into the implementations they re-export.
bzl_library(
    name = "common_bzl",
    srcs = ["common.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//signing:providers_bzl"],
)

bzl_library(
    name = "defs_bzl",
    srcs = [
        "certificate.bzl",
        "sign.bzl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":common_bzl",
        "//signing:providers_bzl",
        "@bazel_lib//lib:stamping",
    ],
)

bzl_library(
    name = "extensions_bzl",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//signing/toolchains:repositories_bzl"],
)
