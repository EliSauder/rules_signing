# An ELF called ".exe", which is what `native_binary` actually produces on
# Linux: it names its output `<name>.exe` on every platform, saying so in its
# own docs. The name is therefore the rule author's convention and not a fact
# about the bytes, and a signer chosen from it would hand a Linux ELF to
# osslsigncode. The platform is pinned rather than taken from the host so the
# expectation holds wherever the suite runs.
platform_binary(
    name = "hello_elf",
    binary = ":hello",
    platform = "@zig_sdk//platform:linux_amd64",
)

native_binary(
    name = "elf_named_exe",
    src = ":hello_elf",
    out = "elf_named_exe.exe",
)

sign(
    name = "signed_elf_named_exe",
    src = ":elf_named_exe",
    certificate = ":dev_cert_generic_pem",
    description = SIGNED_DESCRIPTION,
    url = SIGNED_URL,
)

file_name_manifest(
    name = "signed_elf_named_exe_outputs",
    srcs = [":signed_elf_named_exe"],
)

