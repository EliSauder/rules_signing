# A `certificate` is a file target as well as a provider, so consuming one
# through `srcs` has to yield both halves of the credential. Before the chain
# was added to DefaultInfo this produced only the leaf, which is exactly the
# silent failure that would leave a consumer unable to verify anything.
genrule(
    name = "certificate_default_outputs",
    srcs = [":dev_cert_shared"],
    outs = ["certificate_default_outputs.txt"],
    cmd = """
set -eu
for f in $(SRCS); do basename "$$f"; done | sort > $@
expected="shared.pem
shared_ca.crt"
actual="$$(cat $@)"
if [ "$$actual" != "$$expected" ]; then
    echo "certificate DefaultInfo mismatch" >&2
    echo "expected: $$expected" >&2
    echo "actual:   $$actual" >&2
    exit 1
fi
""",
)

build_test(
    name = "certificate_provides_its_chain_test",
    targets = [":certificate_default_outputs"],
)

# Signing must never rename what it copies: a mangled name silently breaks
# whatever consumes the output, and the rule builds output paths by string
# manipulation, so the risk is real. These fixtures carry names that are
# awkward but legal on every supported platform, deliberately avoiding the
# characters Windows forbids (< > : " / \ | ? *) so the same test runs in CI
# there.
filegroup(
    name = "awkward_named_files",
    srcs = glob(["testdata_names/**"]),
)

file_name_manifest(
    name = "awkward_names_manifest",
    srcs = [":awkward_named_files"],
)

# Without a certificate every file takes the passthrough copy, which isolates
# the rule's path handling from any signer's behaviour.
sign(
    name = "signed_awkward_names_passthrough",
    src = ":awkward_named_files",
    certificate = ":cert_empty",
)

# The same names, but actually signed, so a signer that rewrites or normalizes
# the path it is handed is caught too.
sign(
    name = "signed_awkward_names_cosign",
    src = ":awkward_named_files",
    certificate = ":dev_cert_shared",
    tool = "cosign",
)

file_name_manifest(
    name = "signed_awkward_names_passthrough_outputs",
    srcs = [":signed_awkward_names_passthrough"],
)

file_name_manifest(
    name = "signed_awkward_names_cosign_outputs",
    srcs = [":signed_awkward_names_cosign"],
)

