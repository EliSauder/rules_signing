load("//signing:defs.bzl", "certificate", "self_signed_certificate", "sign")
load("//signing/tests:tree.bzl", "make_tree")
load("//signing/tests:cross.bzl", "platform_binary")
load(
    "//signing/tests:fixtures.bzl",
    "app_bundle",
    "codesign_tool",
    "embedded_sign",
    "jdk_tool",
    "pick_file",
)
load("//signing/tests:manifest.bzl", "file_name_manifest")
load("//signing/tests:jarsigner_toolchain_test.bzl", "jarsigner_toolchain_test_suite")
load(
    "//signing/tests/testdata_certs:certs.bzl",
    "DEV_CERT_PASSWORD",
    "DEV_GENERIC_P12_BASE64",
    "DEV_SHARED_P12_BASE64",
)
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary")
load("@rules_scala//scala:scala.bzl", "scala_binary")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

jarsigner_toolchain_test_suite(name = "jarsigner_toolchain_tests")

filegroup(
    name = "unsigned_files",
    srcs = glob(["testdata_sign/**"]),
)

filegroup(
    name = "unsigned_text_files",
    srcs = glob(["testdata_sign/docs/**"]),
)

certificate(
    name = "cert_empty",
)

certificate(
    name = "cert_template_path",
    certificate = "{CERT_PATH}",
    certificate_encoding = "path",
    password = "{CERT_PASSWORD}",
    password_env = "RULES_SIGNING_CERT_PASSWORD",
    identity = "{CODESIGN_IDENTITY}",
    stamp_defaults = {
        "CERT_PATH": "/definitely/missing/cert.p12",
        "CERT_PASSWORD": "default-password",
        "CODESIGN_IDENTITY": "",
    },
)

sign(
    name = "signed_default",
    src = ":unsigned_files",
)

sign(
    name = "signed_out_override",
    src = ":unsigned_files",
    out = "custom_signed_output",
)

sign(
    name = "signed_force_osslsigncode",
    src = ":unsigned_files",
    tool = "osslsigncode",
)

# A `path`-encoded certificate template that renders to a file which is not
# there is tolerated rather than fatal (see the README), which only holds
# where nothing declared a detached signature as an output. A directory
# artifact is exactly that case: its contents, and so its signatures, are the
# action's to decide.
sign(
    name = "signed_with_cert_template_path",
    src = ":mixed_tree",
    certificate = ":cert_template_path",
    timestamp_url = "https://timestamp.example.invalid",
    description = "rules_signing test description",
    url = "https://example.invalid/publisher",
)

sign(
    name = "signed_with_empty_certificate",
    src = ":unsigned_text_files",
    certificate = ":cert_empty",
)

# A directory artifact holding artifacts that need different signing
# mechanisms (PE signing for exe/dll, detached signatures for the rest).
make_tree(
    name = "mixed_tree",
    files = {
        "bin/app.exe": "fake pe payload",
        "bin/notes.txt": "notes next to a pe file",
        "bin/plugins/helper.dll": "fake dll payload",
        "docs/readme.txt": "readme payload",
        "config.yaml": "config payload",
        "mac/installer.dmg": "fake dmg payload",
    },
)

sign(
    name = "signed_mixed_tree",
    src = ":mixed_tree",
)

# Real cross-compiled executables for content-based detection tests. Both are
# copied to extensionless names, which is what defeats filename-based detection.
cc_binary(
    name = "hello",
    srcs = ["testdata_bin/hello.c"],
    # Only ever built through platform_binary's transition below. Left
    # buildable at top level, its untransitioned config collides on Windows
    # hosts with hello_pe's explicit windows_amd64 transition: both are
    # windows_amd64 with the same toolchain, so cc_binary's implicit
    # "hello.exe" output lands on the exact same path as hello_exe's copy of
    # hello_pe, and Bazel rejects the two conflicting actions.
    tags = ["manual"],
)

platform_binary(
    name = "hello_macho",
    binary = ":hello",
    platform = "@zig_sdk//platform:darwin_arm64",
)

platform_binary(
    name = "hello_pe",
    binary = ":hello",
    platform = "@zig_sdk//platform:windows_amd64",
)

# Exercises the analysis-time path for extensionless files, which must pull in
# every native signer because the contents cannot be inspected until execution.
sign(
    name = "signed_extensionless_binaries",
    src = ":extensionless_binaries",
)

filegroup(
    name = "extensionless_binaries",
    srcs = [
        ":hello_macho",
        ":hello_pe",
    ],
)

# ---------------------------------------------------------------------------
# Real signing fixtures
#
# Everything above signs with certificates that deliberately cannot be
# resolved, which only ever exercises the passthrough path. The targets below
# sign with the checked-in development certificates in //signing/tests/
# testdata_certs, producing genuine signatures that sign_verify_test then
# checks with each tool's own verifier.
# ---------------------------------------------------------------------------

# The same PE binary under a name osslsigncode is selected for by extension,
# complementing the extensionless copy that is selected for by content.
copy_file(
    name = "hello_exe",
    src = ":hello_pe",
    out = "hello.exe",
)

app_bundle(
    name = "hello_app",
    binary = ":hello_macho",
    executable_name = "hello",
    info_plist = "testdata/app_info.plist",
)

# Directory artifacts dispatch per file at execution time. A `sign` target
# carries a single certificate, and no one certificate works across all three
# signers, so the trees are grouped by the signer their contents resolve to.
make_tree(
    name = "blob_tree",
    files = {
        "docs/readme.txt": "readme payload",
        "config.yaml": "config payload",
    },
)

oci_image(
    name = "unsigned_oci_image",
    architecture = "amd64",
    os = "linux",
    # rules_oci's Windows support has known gaps (bazel-contrib/rules_oci#827):
    # the launcher passes a JSON --scratch argument through a .bat wrapper,
    # and cmd.exe's quoting mangles the embedded quotes before jq sees it.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

certificate(
    name = "dev_cert_generic_pem",
    certificate_file = "//signing/tests/testdata_certs:generic.pem",
)

certificate(
    name = "dev_cert_generic_p12",
    certificate_file = "//signing/tests/testdata_certs:generic.p12",
    password = DEV_CERT_PASSWORD,
)

# The base64 encoding takes the certificate as a string rather than a file, and
# is written as a placeholder so template interpolation is covered at the same
# time.
certificate(
    name = "dev_cert_generic_base64",
    certificate = "{DEV_CERTIFICATE}",
    certificate_encoding = "base64",
    password = DEV_CERT_PASSWORD,
    stamp_defaults = {"DEV_CERTIFICATE": DEV_GENERIC_P12_BASE64},
)

certificate(
    name = "dev_cert_apple_pem",
    certificate_file = "//signing/tests/testdata_certs:apple.pem",
    identity = "dev.rules-signing.hello",
)

certificate(
    name = "dev_cert_apple_p12",
    certificate_file = "//signing/tests/testdata_certs:apple.p12",
    identity = "dev.rules-signing.hello",
    password = DEV_CERT_PASSWORD,
)

certificate(
    name = "dev_cert_cosign",
    certificate_file = "//signing/tests/testdata_certs:cosign.key",
    password = DEV_CERT_PASSWORD,
)

# One CA-issued certificate driving every signer. `ca_file` supplies the
# issuing chain, which the signers that use X.509 embed in the signature.
certificate(
    name = "dev_cert_shared",
    ca_file = "//signing/tests/testdata_certs:shared_ca.crt",
    certificate_file = "//signing/tests/testdata_certs:shared.pem",
    identity = "dev.rules-signing.hello",
)

# The same credential as PKCS#12. cosign cannot read PKCS#12, so signing a blob
# with this exercises the openssl conversion path.
certificate(
    name = "dev_cert_shared_p12",
    ca_file = "//signing/tests/testdata_certs:shared_ca.crt",
    certificate = "{DEV_CERTIFICATE}",
    certificate_encoding = "base64",
    identity = "dev.rules-signing.hello",
    password = DEV_CERT_PASSWORD,
    stamp_defaults = {"DEV_CERTIFICATE": DEV_SHARED_P12_BASE64},
)

SIGNED_DESCRIPTION = "rules_signing development signature"

SIGNED_URL = "https://example.invalid/rules_signing"

# Subject and settings for the certificates issued during the build by
# `self_signed_certificate`, shared with the test that verifies them.
SELF_SIGNED_COMMON_NAME = "rules_signing generated (DO NOT TRUST)"

SELF_SIGNED_VALIDITY_DAYS = 30

SELF_SIGNED_PASSWORD = "rules-signing-generated"

sign(
    name = "signed_real_pe_pem",
    src = ":hello_exe",
    certificate = ":dev_cert_generic_pem",
    description = SIGNED_DESCRIPTION,
    tool = "osslsigncode",
    url = SIGNED_URL,
)

# Signed from inside another tool's action against an artifact that does not
# exist at analysis time, which is the only shape available to packagers whose
# finalize hooks sign as a side effect of building. Verified exactly like the
# `sign`-produced PEs above.
embedded_sign(
    name = "signed_real_pe_embedded",
    binary = ":hello_pe",
    signing_certificate = ":dev_cert_generic_pem",
    signing_description = SIGNED_DESCRIPTION,
    signing_tool = "osslsigncode",
    signing_url = SIGNED_URL,
)

sign(
    name = "signed_real_pe_p12",
    src = ":hello_exe",
    certificate = ":dev_cert_generic_p12",
    description = SIGNED_DESCRIPTION,
    tool = "osslsigncode",
    url = SIGNED_URL,
)

sign(
    name = "signed_real_pe_base64",
    src = ":hello_exe",
    certificate = ":dev_cert_generic_base64",
    description = SIGNED_DESCRIPTION,
    tool = "osslsigncode",
    url = SIGNED_URL,
)

# No `tool`, so the extensionless binary has to be routed to osslsigncode on
# the strength of the rule that builds it.
sign(
    name = "signed_real_pe_detected",
    src = ":hello_pe",
    certificate = ":dev_cert_generic_pem",
    description = SIGNED_DESCRIPTION,
    url = SIGNED_URL,
)

# One grouping rule holding a binary and a text file, to pin that detection
# carries through a filegroup and reaches only the file it is true of. The
# group is where a whole-target answer would show up as a wrong one: classify
# by position and the odd file out shifts the binary's verdict onto it, or
# loses both.
filegroup(
    name = "mixed_group",
    srcs = [
        ":hello_pe",
        "testdata_sign/docs/nested/guide.txt",
    ],
)

sign(
    name = "signed_mixed_group",
    src = ":mixed_group",
    certificate = ":dev_cert_generic_pem",
    description = SIGNED_DESCRIPTION,
    url = SIGNED_URL,
)

# Exercises the `stamp` attribute on both `certificate` and `sign` at each of
# its three values, using a base64-templated certificate whose real value
# comes from `tools/workspace_status.py` (see .bazelrc's
# --workspace_status_command), so successful signing proves genuine
# workspace status was read, not merely `stamp_defaults` fallback:
#
#   -1 (follow --stamp/--nostamp): a plain `bazel test` invocation builds
#       with --nostamp, so this behaves like `stamp = 0` here and falls back
#       to `stamp_defaults`, which is the real, valid certificate.
#    0 (never stamp): always falls back to `stamp_defaults`, again the real,
#       valid certificate, proving the target never touches workspace status.
#    1 (always stamp): no `stamp_defaults` are defined at all, so this build
#       only succeeds if the real `STABLE_RULES_SIGNING_TEST_CERT_B64` value
#       from the workspace status script was actually substituted in --
#       there is no fallback value it could have used instead.
_STAMP_TEST_DEFAULTS = {
    -1: {"STABLE_RULES_SIGNING_TEST_CERT_B64": DEV_GENERIC_P12_BASE64},
    0: {"STABLE_RULES_SIGNING_TEST_CERT_B64": DEV_GENERIC_P12_BASE64},
    1: {},
}

[
    certificate(
        name = "dev_cert_generic_base64_stamp_{}".format(stamp_value),
        certificate = "{STABLE_RULES_SIGNING_TEST_CERT_B64}",
        certificate_encoding = "base64",
        password = DEV_CERT_PASSWORD,
        stamp = stamp_value,
        stamp_defaults = _STAMP_TEST_DEFAULTS[stamp_value],
    )
    for stamp_value in [-1, 0, 1]
]

[
    sign(
        name = "signed_real_pe_base64_stamp_{}".format(stamp_value),
        src = ":hello_exe",
        certificate = ":dev_cert_generic_base64_stamp_{}".format(stamp_value),
        description = SIGNED_DESCRIPTION,
        stamp = stamp_value,
        tool = "osslsigncode",
        url = SIGNED_URL,
    )
    for stamp_value in [-1, 0, 1]
]

# The same three stamp settings driven through `signing_attrs`' prefixed
# attributes, where STAMP_ATTRS is declared by the consuming rule rather than
# contributed by SIGNING_ATTRS. Proves the stamp attribute is still found and
# honoured after being decoupled.
[
    embedded_sign(
        name = "embedded_pe_base64_stamp_{}".format(stamp_value),
        binary = ":hello_pe",
        signing_certificate = ":dev_cert_generic_base64_stamp_{}".format(stamp_value),
        signing_tool = "osslsigncode",
        stamp = stamp_value,
    )
    for stamp_value in [-1, 0, 1]
]

build_test(
    name = "stamp_attr_test",
    targets = [
        ":signed_real_pe_base64_stamp_-1",
        ":signed_real_pe_base64_stamp_0",
        ":signed_real_pe_base64_stamp_1",
        ":embedded_pe_base64_stamp_-1",
        ":embedded_pe_base64_stamp_0",
        ":embedded_pe_base64_stamp_1",
    ],
)

# Timestamping is disabled throughout: rcodesign otherwise contacts
# timestamp.apple.com, which would make every build depend on the network.
sign(
    name = "signed_real_macho_pem",
    src = ":hello_macho",
    certificate = ":dev_cert_apple_pem",
    entitlements = "testdata/entitlements.plist",
    options = ["runtime"],
    tool = "codesign",
)

sign(
    name = "signed_real_macho_p12",
    src = ":hello_macho",
    certificate = ":dev_cert_apple_p12",
    entitlements = "testdata/entitlements.plist",
    options = ["runtime"],
    tool = "codesign",
)

# Bundles are directory artifacts signed as a single unit rather than file by
# file, which is a different code path from the per-file tree walk.
sign(
    name = "signed_real_app_bundle",
    src = ":hello_app",
    certificate = ":dev_cert_apple_pem",
    options = ["runtime"],
    tool = "codesign",
)

sign(
    name = "signed_real_blobs",
    src = ":unsigned_text_files",
    certificate = ":dev_cert_cosign",
    tool = "cosign",
)

sign(
    name = "signed_real_blob_tree",
    src = ":blob_tree",
    certificate = ":dev_cert_cosign",
)

# One source a native signer claims and one it does not, so that
# `detached_signatures` is observed doing the thing it exists for: making the
# output set the same for both of them.
filegroup(
    name = "pe_and_blob",
    srcs = [
        "testdata_sign/docs/readme.txt",
        ":hello_exe",
    ],
)

# Every source gets a detached signature. The PE is still signed natively as
# well, so it carries both, and the detached signature is taken over the PE as
# it is delivered -- signature included -- which sign_verify_test checks by
# verifying each of them against the same output file.
sign(
    name = "signed_always_detached",
    src = ":pe_and_blob",
    certificate = ":dev_cert_shared",
    detached_signatures = "always",
)

# No source gets one, leaving only what a native signer embeds. The text file
# has no native signer, so it is copied through unsigned.
sign(
    name = "signed_never_detached",
    src = ":pe_and_blob",
    certificate = ":dev_cert_shared",
    detached_signatures = "never",
)

pick_file(
    name = "signed_always_detached_exe",
    src = ":signed_always_detached",
    suffix = "signing/tests/hello.exe",
)

pick_file(
    name = "signed_always_detached_readme",
    src = ":signed_always_detached",
    suffix = "docs/readme.txt",
)

pick_file(
    name = "signed_never_detached_exe",
    src = ":signed_never_detached",
    suffix = "signing/tests/hello.exe",
)

sign(
    name = "signed_real_oci_image",
    src = ":unsigned_oci_image",
    certificate = ":dev_cert_cosign",
)

# ---------------------------------------------------------------------------
# One certificate, every signer. Each of these uses :dev_cert_shared.
# ---------------------------------------------------------------------------

sign(
    name = "signed_shared_pe",
    src = ":hello_exe",
    certificate = ":dev_cert_shared",
    description = SIGNED_DESCRIPTION,
    tool = "osslsigncode",
    url = SIGNED_URL,
)

sign(
    name = "signed_shared_macho",
    src = ":hello_macho",
    certificate = ":dev_cert_shared",
    entitlements = "testdata/entitlements.plist",
    options = ["runtime"],
    tool = "codesign",
)

# kotlin_greeting is defined further down, alongside the rest of the JVM
# fixtures; labels resolve at analysis time, so the forward reference here is
# fine.
sign(
    name = "signed_shared_jar",
    src = ":kotlin_greeting",
    certificate = ":dev_cert_shared",
)

pick_file(
    name = "signed_shared_jar_jar",
    src = ":signed_shared_jar",
    suffix = "kotlin_greeting.jar",
)

sign(
    name = "signed_shared_blobs",
    src = ":unsigned_text_files",
    certificate = ":dev_cert_shared",
    tool = "cosign",
)

# PKCS#12 has to be converted before cosign will accept it, which needs the
# openssl toolchain registered.
sign(
    name = "signed_shared_blobs_from_p12",
    src = ":unsigned_text_files",
    certificate = ":dev_cert_shared_p12",
    tool = "cosign",
)

# ---------------------------------------------------------------------------
# Certificates issued during the build by `self_signed_certificate`, rather
# than checked in. Each is signed with for real and verified against its own
# generated trust anchor, which is the only thing that proves the generated
# material is a usable credential and not merely a well-formed file.
# ---------------------------------------------------------------------------

self_signed_certificate(
    name = "self_signed_pem_cert",
    common_name = SELF_SIGNED_COMMON_NAME,
    organization = "rules_signing tests",
    subject_alt_names = ["DNS:rules-signing.invalid"],
    validity_days = SELF_SIGNED_VALIDITY_DAYS,
)

# The other end of the matrix: an EC key in a password-protected PKCS#12
# bundle, so both key algorithms and both output formats are covered.
self_signed_certificate(
    name = "self_signed_p12_cert",
    common_name = SELF_SIGNED_COMMON_NAME,
    format = "p12",
    key_type = "ec",
    password = SELF_SIGNED_PASSWORD,
    validity_days = SELF_SIGNED_VALIDITY_DAYS,
)

# The generated files are not predeclared outputs, so they are pulled out
# individually through the output groups the rule exposes.
[
    filegroup(
        name = "{}_{}".format(cert, group),
        srcs = [":" + cert],
        output_group = group,
    )
    for cert in [
        "self_signed_pem_cert",
        "self_signed_p12_cert",
    ]
    for group in [
        "certificate",
        "certificate_only",
        "public_key",
    ]
]

sign(
    name = "signed_self_signed_pe",
    src = ":hello_exe",
    certificate = ":self_signed_pem_cert",
    tool = "osslsigncode",
)

sign(
    name = "signed_self_signed_pe_p12",
    src = ":hello_exe",
    certificate = ":self_signed_p12_cert",
    tool = "osslsigncode",
)

sign(
    name = "signed_self_signed_blobs",
    src = ":unsigned_text_files",
    certificate = ":self_signed_pem_cert",
    tool = "cosign",
)

# Gives tests the rcodesign binary, which unlike cosign and osslsigncode is
# only reachable through toolchain resolution.
codesign_tool(name = "codesign_tool")

jdk_tool(
    name = "jarsigner_tool",
    tool_name = "jarsigner",
)

jdk_tool(
    name = "keytool_tool",
    tool_name = "keytool",
)

py_test(
    name = "self_signed_certificate_test",
    size = "small",
    srcs = [
        "//signing:__init__.py",
        "__init__.py",
        "self_signed_certificate_test.py",
    ],
    args = [
        "--openssl=$(rootpath @signing_openssl//:openssl_file)",
        "--osslsigncode=$(rootpath @signing_osslsigncode//:osslsigncode_file)",
        "--cosign=$(rootpath @signing_cosign//:cosign_file)",
        "--common-name='" + SELF_SIGNED_COMMON_NAME + "'",
        "--validity-days=" + str(SELF_SIGNED_VALIDITY_DAYS),
        "--p12-password=" + SELF_SIGNED_PASSWORD,
        "--pem-material=$(rootpath :self_signed_pem_cert_certificate)",
        "--pem-certificate=$(rootpath :self_signed_pem_cert_certificate_only)",
        "--pem-public-key=$(rootpath :self_signed_pem_cert_public_key)",
        "--p12-material=$(rootpath :self_signed_p12_cert_certificate)",
        "--p12-certificate=$(rootpath :self_signed_p12_cert_certificate_only)",
        "--signed-pe=$(rootpath :signed_self_signed_pe)::" +
        "$(rootpath :self_signed_pem_cert_certificate_only)",
        "--signed-pe=$(rootpath :signed_self_signed_pe_p12)::" +
        "$(rootpath :self_signed_p12_cert_certificate_only)",
        "--signed-blob=$(rootpath :signed_self_signed_blobs_readme)",
    ],
    data = [
        ":self_signed_p12_cert_certificate",
        ":self_signed_p12_cert_certificate_only",
        ":self_signed_pem_cert_certificate",
        ":self_signed_pem_cert_certificate_only",
        ":self_signed_pem_cert_public_key",
        ":signed_self_signed_blobs",
        ":signed_self_signed_blobs_readme",
        ":signed_self_signed_pe",
        ":signed_self_signed_pe_p12",
        "@signing_cosign//:cosign_file",
        "@signing_openssl//:openssl_file",

        # openssl.exe on Windows loads libcrypto/libssl from its own
        # directory, so the executable alone is not runnable; this stages
        # whatever has to sit beside it.
        "@signing_openssl//:openssl_files",
        "@signing_osslsigncode//:osslsigncode_file",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# `sign` emits one output per source, so a test that verifies a single
# signature names that one file rather than a path inside a directory. These
# are the files whose signatures sign_verify_test and
# self_signed_certificate_test check.
pick_file(
    name = "signed_real_pe_detected_binary",
    src = ":signed_real_pe_detected",
    suffix = "signing/tests/hello_pe",
)

pick_file(
    name = "signed_real_blobs_readme",
    src = ":signed_real_blobs",
    suffix = "docs/readme.txt",
)

pick_file(
    name = "signed_real_blobs_guide",
    src = ":signed_real_blobs",
    suffix = "docs/nested/guide.txt",
)

pick_file(
    name = "signed_shared_blobs_readme",
    src = ":signed_shared_blobs",
    suffix = "docs/readme.txt",
)

pick_file(
    name = "signed_shared_blobs_from_p12_readme",
    src = ":signed_shared_blobs_from_p12",
    suffix = "docs/readme.txt",
)

pick_file(
    name = "signed_self_signed_blobs_readme",
    src = ":signed_self_signed_blobs",
    suffix = "docs/readme.txt",
)

py_test(
    name = "sign_verify_test",
    size = "small",
    srcs = [
        "//signing:__init__.py",
        "__init__.py",
        "sign_verify_test.py",
    ],
    args = [
        "--osslsigncode=$(rootpath @signing_osslsigncode//:osslsigncode_file)",
        "--cosign=$(rootpath @signing_cosign//:cosign_file)",
        "--codesign=$(rootpath :codesign_tool)",
        "--jarsigner=$(rootpath :jarsigner_tool)",
        "--keytool=$(rootpath :keytool_tool)",
        "--generic-ca=$(rootpath //signing/tests/testdata_certs:generic.crt)",
        "--cosign-public-key=$(rootpath //signing/tests/testdata_certs:cosign.pub)",
        # Quoted because Bazel applies shell tokenization to `args`, which
        # would otherwise split a multi-word value into separate arguments.
        "--description='" + SIGNED_DESCRIPTION + "'",
        "--url=" + SIGNED_URL,
        "--identity=dev.rules-signing.hello",
        # Paths inside a signed tree mirror the source's own layout, except
        # when the whole tree is a single directory artifact, which is
        # flattened to the root of the output.
        "--pe=$(rootpath :signed_real_pe_pem)",
        "--pe=$(rootpath :signed_real_pe_p12)",
        "--pe=$(rootpath :signed_real_pe_base64)",
        "--pe=$(rootpath :signed_real_pe_detected_binary)",
        "--pe=$(rootpath :signed_real_pe_embedded)",
        "--macho=$(rootpath :signed_real_macho_pem)",
        "--macho=$(rootpath :signed_real_macho_p12)",
        "--app-bundle=$(rootpath :signed_real_app_bundle)",
        "--signed-blob=$(rootpath :signed_real_blobs_readme)",
        "--signed-blob=$(rootpath :signed_real_blobs_guide)",
        "--signed-blob=$(rootpath :signed_real_blob_tree)/docs/readme.txt",
        "--signed-blob=$(rootpath :signed_real_blob_tree)/config.yaml",
        # A jar signed in place by jarsigner rather than cosign; the `.jar`
        # signature is embedded, so there is no sidecar to hand to a verifier.
        "--jar=$(rootpath :signed_kotlin_greeting_jar)",
        "--jar=$(rootpath :signed_scala_greeting_jar)",
        # The single certificate that drives all three signers. Verification
        # trusts only the root, so the intermediate has to have travelled
        # inside each signature by way of the certificate's `ca_file`.
        "--shared-root=$(rootpath //signing/tests/testdata_certs:shared_root.crt)",
        "--shared-public-key=$(rootpath //signing/tests/testdata_certs:shared.pub)",
        "--shared-pe=$(rootpath :signed_shared_pe)",
        # Both `detached_signatures` modes still embed the PE signature, and
        # under "always" the detached one is taken over the PE as delivered,
        # so verifying it against that same file is what proves the two were
        # applied in an order that leaves both valid.
        "--shared-pe=$(rootpath :signed_always_detached_exe)",
        "--shared-pe=$(rootpath :signed_never_detached_exe)",
        "--shared-macho=$(rootpath :signed_shared_macho)",
        "--shared-jar=$(rootpath :signed_shared_jar_jar)",
        "--shared-blob=$(rootpath :signed_always_detached_exe)",
        "--shared-blob=$(rootpath :signed_always_detached_readme)",
        "--shared-blob=$(rootpath :signed_shared_blobs_readme)",
        "--shared-blob=$(rootpath :signed_shared_blobs_from_p12_readme)",
    ] + select({
        # oci_image (and anything depending on it) is target_compatible_with
        # excluded on Windows; see unsigned_oci_image for why.
        "@platforms//os:windows": [],
        "//conditions:default": ["--signed-oci=$(rootpath :signed_real_oci_image)"],
    }),
    data = [
        ":codesign_tool",
        ":jarsigner_tool",
        ":keytool_tool",
        ":signed_kotlin_greeting_jar",
        ":signed_scala_greeting_jar",
        ":signed_shared_jar_jar",
        ":signed_real_app_bundle",
        ":signed_real_blob_tree",
        ":signed_real_blobs",
        ":signed_real_blobs_guide",
        ":signed_real_blobs_readme",
        ":signed_real_macho_p12",
        ":signed_always_detached",
        ":signed_always_detached_exe",
        ":signed_always_detached_readme",
        ":signed_never_detached",
        ":signed_never_detached_exe",
        ":signed_real_macho_pem",
        ":signed_real_pe_base64",
        ":signed_real_pe_detected",
        ":signed_real_pe_detected_binary",
        ":signed_real_pe_embedded",
        ":signed_real_pe_p12",
        ":signed_real_pe_pem",
        ":signed_shared_blobs",
        ":signed_shared_blobs_from_p12",
        ":signed_shared_blobs_from_p12_readme",
        ":signed_shared_blobs_readme",
        ":signed_shared_macho",
        ":signed_shared_pe",
        "//signing/tests/testdata_certs:cosign.pub",
        "//signing/tests/testdata_certs:generic.crt",
        "//signing/tests/testdata_certs:shared.pub",
        "//signing/tests/testdata_certs:shared_root.crt",
        "@signing_cosign//:cosign_file",
        "@signing_osslsigncode//:osslsigncode_file",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": [":signed_real_oci_image"],
    }),
    deps = [
        "//signing/private/tools:sign_tool_lib",
        "@rules_python//python/runfiles",
    ],
)

