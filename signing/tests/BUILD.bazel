load("//signing:defs.bzl", "sign", "certificate")
load("//signing/tests:tree.bzl", "make_tree")
load("//signing/tests:cross.bzl", "platform_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "unsigned_files",
    srcs = glob(["testdata_sign/**"]),
)

filegroup(
    name = "unsigned_text_files",
    srcs = glob(["testdata_sign/docs/**"]),
)

certificate(
    name = "cert_empty",
)

certificate(
    name = "cert_template_path",
    certificate = "{CERT_PATH}",
    certificate_encoding = "path",
    password = "{CERT_PASSWORD}",
    password_env = "RULES_SIGNING_CERT_PASSWORD",
    identity = "{CODESIGN_IDENTITY}",
    stamp_defaults = {
        "CERT_PATH": "/definitely/missing/cert.p12",
        "CERT_PASSWORD": "default-password",
        "CODESIGN_IDENTITY": "",
    },
)

sign(
    name = "signed_default",
    src = ":unsigned_files",
)

sign(
    name = "signed_out_override",
    src = ":unsigned_files",
    out = "custom_signed_output",
)

sign(
    name = "signed_force_osslsigncode",
    src = ":unsigned_files",
    tool = "osslsigncode",
)

sign(
    name = "signed_with_cert_template_path",
    src = ":unsigned_text_files",
    certificate = ":cert_template_path",
    timestamp_url = "https://timestamp.example.invalid",
    description = "rules_signing test description",
    url = "https://example.invalid/publisher",
)

sign(
    name = "signed_with_empty_certificate",
    src = ":unsigned_text_files",
    certificate = ":cert_empty",
)

# A directory artifact holding artifacts that need different signing
# mechanisms (PE signing for exe/dll, detached signatures for the rest).
make_tree(
    name = "mixed_tree",
    files = {
        "bin/app.exe": "fake pe payload",
        "bin/notes.txt": "notes next to a pe file",
        "bin/plugins/helper.dll": "fake dll payload",
        "docs/readme.txt": "readme payload",
        "config.yaml": "config payload",
        "mac/installer.dmg": "fake dmg payload",
    },
)

sign(
    name = "signed_mixed_tree",
    src = ":mixed_tree",
)

# Real cross-compiled executables for content-based detection tests. Both are
# copied to extensionless names, which is what defeats filename-based detection.
cc_binary(
    name = "hello",
    srcs = ["testdata_bin/hello.c"],
)

platform_binary(
    name = "hello_macho",
    binary = ":hello",
    platform = "@zig_sdk//platform:darwin_arm64",
)

platform_binary(
    name = "hello_pe",
    binary = ":hello",
    platform = "@zig_sdk//platform:windows_amd64",
)

# Exercises the analysis-time path for extensionless files, which must pull in
# every native signer because the contents cannot be inspected until execution.
sign(
    name = "signed_extensionless_binaries",
    src = ":extensionless_binaries",
)

filegroup(
    name = "extensionless_binaries",
    srcs = [
        ":hello_macho",
        ":hello_pe",
    ],
)

py_test(
    name = "sign_tool_unit_test",
    srcs = ["sign_tool_unit_test.py"],
    size = "small",
    data = [
        ":hello_macho",
        ":hello_pe",
    ],
    deps = [
        "//signing/private/tools:sign_tool_lib",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "sign_integration_test",
    srcs = ["sign_integration_test.py"],
    size = "small",
    data = [
        ":unsigned_files",
        ":unsigned_text_files",
        ":signed_default",
        ":signed_out_override",
        ":signed_force_osslsigncode",
        ":signed_with_cert_template_path",
        ":signed_with_empty_certificate",
        ":signed_mixed_tree",
    ],
    args = [
        "$(rootpath :signed_default)::signing/tests/testdata_sign",
        "$(rootpath :signed_out_override)::signing/tests/testdata_sign",
        "$(rootpath :signed_force_osslsigncode)::signing/tests/testdata_sign",
        "$(rootpath :signed_with_cert_template_path)::signing/tests/testdata_sign/docs",
        "$(rootpath :signed_with_empty_certificate)::signing/tests/testdata_sign/docs",
        "--mixed-tree=$(rootpath :signed_mixed_tree)",
    ],
)
