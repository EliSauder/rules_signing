load("@rules_dotnet//dotnet:defs.bzl", "csharp_binary", "csharp_library", "import_library", "publish_binary")
load("//signing:defs.bzl", "sign")
load("//signing/tests:manifest.bzl", "file_name_manifest")

package(default_visibility = ["//signing/tests:__pkg__"])

# Stands in for a NuGet package: its files are checked in rather than built.
# Neither is the binary its name claims, so a build that hands either to a
# signer fails instead of passing by accident.
import_library(
    name = "vendor",
    libs = ["Vendor.dll"],
    library_name = "Vendor",
    native = ["runtimes/linux-x64/native/libvendor.so"],
    version = "1.0.0",
)

csharp_library(
    name = "lib",
    srcs = ["Lib.cs"],
    target_frameworks = ["net9.0"],
    deps = [":vendor"],
)

csharp_binary(
    name = "app",
    srcs = ["App.cs"],
    target_frameworks = ["net9.0"],
    deps = [":lib"],
)

publish_binary(
    name = "publish",
    binary = ":app",
    target_framework = "net9.0",
)

sign(
    name = "signed_app",
    src = ":app",
    certificate = "//signing/tests:dev_cert_generic_pem",
)

sign(
    name = "signed_publish",
    src = ":publish",
    certificate = "//signing/tests:dev_cert_generic_pem",
)

sign(
    name = "signed_publish_always",
    src = ":publish",
    certificate = "//signing/tests:dev_cert_generic_pem",
    detached_signatures = "always",
)

sign(
    name = "signed_publish_cosign",
    src = ":publish",
    certificate = "//signing/tests:dev_cert_generic_pem",
    tool = "cosign",
)

[
    file_name_manifest(
        name = "signed_{}_outputs".format(name),
        srcs = [":signed_" + name],
    )
    for name in [
        "app",
        "publish",
        "publish_always",
        "publish_cosign",
    ]
]
