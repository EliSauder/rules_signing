module(
    name = "rules_signing",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "codesign.bzl", version = "0.0.13")

# Provides a hermetic `openssl` for the tests that exercise converting PKCS#12
# signing material into the PEM form cosign requires
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")


bazel_dep(name = "llvm", version = "0.8.17")

llvm = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm.exec(
    arch = "aarch64",
    os = "macos",
)
llvm.exec(
    arch = "x86_64",
    os = "macos",
)
llvm.target(
    arch = "aarch64",
    os = "macos",
)
llvm.target(
    arch = "x86_64",
    os = "macos",
)
use_repo(llvm, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# Needed for openssl and test cross-compiles the real Mach-O/PE test binaries
# used to verify content-based tool detection.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
zig_toolchains.exec_platform(
    arch = "amd64",
    os = "linux",
)
zig_toolchains.exec_platform(
    arch = "arm64",
    os = "linux",
)
zig_toolchains.exec_platform(
    arch = "arm64",
    os = "windows",
)
zig_toolchains.exec_platform(
    arch = "amd64",
    os = "windows",
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    # Linux hosts included so the fixtures compile hermetically everywhere,
    # rather than depending on whatever system C toolchain is installed.
    "@zig_sdk//toolchain:all",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)

signing_tools = use_extension("//signing:extensions.bzl", "signing_tools", dev_dependency = True)
signing_tools.openssl()
use_repo(
    signing_tools,
    "signing_cosign",
    "signing_openssl",
    "signing_osslsigncode",
)

# Registered only for this module's own tests. Consumers pick their own tool
# versions and register their own toolchains; nothing here leaks downstream.
register_toolchains(
    "@signing_cosign//:cosign_toolchain",
    "@signing_openssl//:openssl_toolchain",
    "@signing_osslsigncode//:osslsigncode_toolchain",
    dev_dependency = True,
)

# LIEF parses Mach-O/PE headers so extensionless binaries are classified by
# content instead of by filename. This is a genuine runtime dependency of
# sign_tool, so the hub is non-dev; consumers get it transitively without
# having to declare anything.
PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = PYTHON_VERSION)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "signing_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//signing/private/tools:requirements.txt",
)
use_repo(pip, "signing_pypi")

# cryptography is used only by the maintainer tool that regenerates the
# checked-in development certificates, never by the tests themselves. It gets
# its own dev-only pip hub so it cannot leak to consumers via signing_pypi.
pip_tests = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip_tests.parse(
    hub_name = "signing_tests_pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//signing/tests/testdata_certs:requirements.txt",
)
use_repo(pip_tests, "signing_tests_pypi")

# The codesign toolchain type comes from codesign.bzl, but registering an
# implementation is the consumer's choice, so this stays dev-only too.
register_toolchains(
    "@codesign.bzl//toolchain:all",
    dev_dependency = True,
)
