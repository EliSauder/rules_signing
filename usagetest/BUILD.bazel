load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_signing//signing:defs.bzl", "sign")
load(":toolchain_test.bzl", "missing_codesign_test", "missing_jarsigner_test")

genrule(
    name = "unsigned_dmg",
    outs = ["unsigned.dmg"],
    cmd = "echo dmg > $@",
)

sign(
    name = "dmg_without_toolchain",
    src = ":unsigned_dmg",
    tags = ["manual"],
)

missing_codesign_test(
    name = "missing_codesign_test",
    target_under_test = ":dmg_without_toolchain",
)

genrule(
    name = "unsigned_jar",
    outs = ["unsigned.jar"],
    cmd = "echo jar > $@",
)

sign(
    name = "jar_without_toolchain",
    src = ":unsigned_jar",
    tags = ["manual"],
)

missing_jarsigner_test(
    name = "missing_jarsigner_test",
    target_under_test = ":jar_without_toolchain",
)

genrule(
    name = "unsigned_outputs",
    outs = [
        "bin/app.exe",
        "docs/readme.txt",
        "nested/a/b/guide.txt",
    ],
    cmd = """
      mkdir -p $(@D)/bin $(@D)/docs $(@D)/nested/a/b
      printf 'consumer exe\\n' > $(@D)/bin/app.exe
      printf 'consumer docs\\n' > $(@D)/docs/readme.txt
      printf 'consumer nested\\n' > $(@D)/nested/a/b/guide.txt
    """,
)

sign(
    name = "signed_outputs",
    src = ":unsigned_outputs",
)

oci_image(
    name = "unsigned_oci_image",
    os = "linux",
    architecture = "amd64",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

sign(
    name = "signed_oci_image",
    src = ":unsigned_oci_image",
    # The consumer intentionally registers no JDK; OCI signing only needs cosign.
    tool = "cosign",
)

# Runs as part of the BCR presubmit's `test_targets`, so a downstream
# consumer's `bazel test //...` actually exercises the signed output tree
# rather than only building it.
py_test(
    name = "verify_outputs_test",
    size = "small",
    srcs = ["verify_outputs_test.py"],
    args = ["$(rootpaths :signed_outputs)"] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["--signed-oci-image=$(rootpath :signed_oci_image)"],
    }),
    data = [":signed_outputs"] + select({
        "@platforms//os:windows": [],
        "//conditions:default": [":signed_oci_image"],
    }),
)
