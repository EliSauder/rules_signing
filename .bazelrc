# On Windows, py_binary/py_test default to bundling runfiles into a zip
# built by Bazel's zipper, which pairs each runfile as `<dest>=<src>`. That
# format breaks when a runfile's own path contains "=" (e.g. our awkward file
# name fixtures), since the zipper splits on the first "=" it finds, even if
# that "=" belongs to <dest> rather than the delimiter. Using real runfiles
# trees instead of a zip sidesteps that limitation entirely.
#
# rules_python decides whether to build the zip by reading either its own
# Starlark flag (below) or, when the legacy `ctx.fragments.py` API is still
# available (true for Bazel 8), the deprecated native `--build_python_zip`
# flag instead -- see rules_python's `read_possibly_native_flag`. Both must be
# set to `false`/off so the behavior is consistent across Bazel 8 and 9.
build --enable_runfiles
build --@rules_python//python/config_settings:build_python_zip=false
build --build_python_zip=false

# Provides a real STABLE_ value for //signing/tests:stamp_attr_test, so that
# target's `stamp = 1` certificate is proven to read genuine workspace status
# rather than merely falling back to `stamp_defaults`. This script only
# base64-encodes an already-checked-in test fixture, so it stays cheap enough
# to run on every build rather than being opt-in behind --config=release.
build --workspace_status_command=tools/workspace_status.sh
